# Postgres local (docker compose up -d)
DATABASE_URL=postgres://consultorio:consultorio@localhost:5432/consultorio
TEST_DATABASE_URL=postgres://consultorio:consultorio@localhost:5432/consultorio_test
PORT=3000
NODE_ENV=development
# Corre el worker (vencimientos + lista de espera + recordatorios) dentro del mismo proceso
RUN_WORKER=true
# URL pública del sitio: va en los links de WhatsApp (en Render se toma sola de RENDER_EXTERNAL_URL)
PUBLIC_URL=http://localhost:3000
# En producción, cargar los usuarios de demo (contraseña pública demo1234). Nunca con pacientes reales.
SEED_DEMO=false

# --- WhatsApp Cloud API (opcional). Sin token, los mensajes se imprimen por consola. ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Token que inventás y cargás en Meta al configurar el webhook (GET /api/webhooks/whatsapp)
WHATSAPP_VERIFY_TOKEN=
# "App secret" de la app de Meta: valida la firma X-Hub-Signature-256 de cada webhook
WHATSAPP_APP_SECRET=
# Plantillas aprobadas en Meta (fuera de la ventana de 24 h Meta solo acepta plantillas).
# Cuerpo con 4 variables: {{1}} nombre, {{2}} estudio, {{3}} fecha y hora, {{4}} link
WHATSAPP_TEMPLATE_RECORDATORIO=
WHATSAPP_TEMPLATE_LISTA_ESPERA=
WHATSAPP_TEMPLATE_LANG=es_AR
# Webhook simple { telefono, texto } para pruebas e integraciones propias
WEBHOOK_SECRET=cambiame

# Secreto para POST /api/interno/ciclo (cron externo que despierta el servidor)
CRON_SECRET=
# Backups (npm run backup)
BACKUP_DIR=./backups
BACKUP_KEEP=30
